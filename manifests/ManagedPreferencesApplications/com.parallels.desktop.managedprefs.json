{
    "title": "Parallels Desktop for Mac (com.parallels.desktop.managedprefs)",
    "description": "Parallels Desktop Settings",
    "properties": {
        "ActivationExperience": {
            "type": "string",
            "title": "Activation Experience",
            "default": "SSO",
            "description": "Select a method for activating Parallels Desktop for Mac",
            "links": [
                {
                    "rel": "More information",
                    "href": "https://link.parallels.com/pde-mdm-activation-experience"
                }
            ],
            "enum": [
                "License Key",
                "SSO"
            ],
            "property_order": 5
        },
        "LicenseKey": {
            "type": "string",
            "title": "License Key",
            "description": "Enter your 30-character license key:",
            "pattern": "^[0-9A-Za-z]{6}-[0-9A-Za-z]{6}-[0-9A-Za-z]{6}-[0-9A-Za-z]{6}-[0-9A-Za-z]{6}$",
            "links": [
                {
                    "rel": "More information",
                    "href": "https://link.parallels.com/pde-mdm-pd-licensing"
                }
            ],
            "property_order": 10
        },
        "SsoEmailDialogHeaderText": {
            "type": "string",
            "title": "SSO Dialogue Header Text (Optional)",
            "description": "Enter SSO dialogue header text:",
            "links": [
                {
                    "rel": "More information",
                    "href": "https://link.parallels.com/pde-mdm-sso-header"
                }
            ],
            "property_order": 15
        },
        "SsoEmailDialogDescriptionText": {
            "type": "string",
            "title": "SSO Dialogue Description Text (Optional)",
            "description": "Enter SSO dialogue description text:",
            "links": [
                {
                    "rel": "More information",
                    "href": "https://link.parallels.com/pde-mdm-sso-description"
                }
            ],
            "property_order": 20
        },
        "SsoEmailDialogLabelText": {
            "type": "string",
            "title": "SSO Dialogue Label Text (Optional)",
            "description": "Enter SSO dialogue label text:",
            "links": [
                {
                    "rel": "More information",
                    "href": "https://link.parallels.com/pde-mdm-sso-email"
                }
            ],
            "property_order": 25
        }
    }
}